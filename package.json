{
  "name": "sumexxx-github-io",
  "version": "0.1.0",
  "private": true,
  "description": "Suman Debnath — profile and blog, statically exported to GitHub Pages.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build && node scripts/publish-root.mjs",
    "start": "npx serve .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "prepare": "husky",
    "knip": "knip"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-use-controllable-state": "^1.3.0",
    "@react-three/fiber": "^9.8.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.10.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9",
    "@next/eslint-plugin-next": "^16.4.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^25.0.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "knip": "^5.76.1",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "typescript-eslint": "^8"
  }
}
